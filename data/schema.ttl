@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bib:  <http://ejemplo.org/biblioteca#> .
 
# ── CLASES ──────────────────────────────────────────────────────
bib:Libro       a owl:Class ;
                rdfs:label "Libro" .
 
bib:Autor       a owl:Class ;
                rdfs:label "Autor" .
 
bib:Editorial   a owl:Class ;
                rdfs:label "Editorial" .
 
# ── PROPIEDADES DE DATOS (literales) ─────────────────────────────
bib:titulo      a owl:DatatypeProperty ;
                rdfs:domain bib:Libro ;
                rdfs:range  xsd:string .
 
bib:anio        a owl:DatatypeProperty ;
                rdfs:domain bib:Libro ;
                rdfs:range  xsd:integer .
 
bib:isbn        a owl:DatatypeProperty ;
                rdfs:domain bib:Libro ;
                rdfs:range  xsd:string .
 
bib:nombre      a owl:DatatypeProperty ;
                rdfs:domain owl:Thing ;
                rdfs:range  xsd:string .
 
bib:nacionalidad a owl:DatatypeProperty ;
                rdfs:domain bib:Autor ;
                rdfs:range  xsd:string .

# ── PROPIEDADES DE OBJETO (relaciones entre recursos) ─────────────
bib:escritoPor  a owl:ObjectProperty ;
                rdfs:domain bib:Libro ;
                rdfs:range  bib:Autor .
 
bib:publicadoPor a owl:ObjectProperty ;
                rdfs:domain bib:Libro ;
                rdfs:range  bib:Editorial .
